# 复制为 .env 后按需修改；不要提交真实密钥。
# Node 启动时会自动读取本文件（server/env.mjs）。

# 站点共享额度：存在时访客可以不带自己的 API Key 试用（受每日额度与限流约束）。
# HOSTED_LLM_TOKEN=
# HOSTED_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# HOSTED_LLM_MODEL=Qwen/Qwen3-8B
# HOSTED_LLM_MAX_TOKENS=1200
# HOSTED_REQUESTS_PER_IP_PER_DAY=40
# HOSTED_REQUESTS_PER_DAY=800
# LLM_REQUESTS_PER_MINUTE=20

# Edge TTS 解释器（容器内为 python3；Windows 本地可指向自己的 Python）
# EDGE_TTS_PYTHON=python3

# 额外放行的模型 Base URL 主机（逗号分隔）
# ALLOW_MODEL_HOSTS=llm.example.com

# 监听地址与端口（创空间固定 0.0.0.0:7860）
# HOST=0.0.0.0
# PORT=7860