# 复制为 .env 后按需修改；不要提交真实密钥。
# Node 启动时会自动读取本文件（server/env.mjs）。

# 站点共享额度：存在时访客可以不带自己的 API Key 试用（受每日额度与限流约束）。
# HOSTED_LLM_TOKEN=
# HOSTED_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# HOSTED_LLM_MODEL=Qwen/Qwen3-8B
# HOSTED_LLM_MAX_TOKENS=1200
# HOSTED_REQUESTS_PER_IP_PER_DAY=40
# HOSTED_REQUESTS_PER_DAY=800
# LLM_REQUESTS_PER_MINUTE=20

# Edge TTS 解释器（容器内为 python3；Windows 本地可指向自己的 Python）
# EDGE_TTS_PYTHON=python3

# 服务端语音识别（建议开启）：访客无需自带 Key，也不依赖浏览器自带语音服务（Google），内嵌场景更稳。
# 契约：上游需提供 OpenAI 兼容的 POST {ASR_BASE_URL}/audio/transcriptions（multipart: file/model/language）并返回 {"text": "..."}。
# 不填 ASR_BASE_URL / ASR_TOKEN 时会回落到上面的 HOSTED_LLM_BASE_URL / HOSTED_LLM_TOKEN，
# 例如魔搭 API-Inference 的令牌可同时用于 LLM 与 ASR。
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# ASR_TOKEN=
# ASR_LANGUAGE=zh
# ASR_REQUESTS_PER_MINUTE=20
# ASR_REQUESTS_PER_DAY=600
# ASR_MAX_BYTES=8388608
# ASR_TIMEOUT_MS=45000
# ASR_PROVIDER=off

# 额外放行的模型 Base URL 主机（逗号分隔）
# ALLOW_MODEL_HOSTS=llm.example.com

# 允许内嵌本站的祖先页面，默认 *（任意 http/https 站点）；收紧示例：
# ALLOWED_FRAME_ANCESTORS=https://modelscope.cn

# 监听地址与端口（创空间固定 0.0.0.0:7860）
# HOST=0.0.0.0
# PORT=7860
